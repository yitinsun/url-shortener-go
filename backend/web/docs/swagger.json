{
    "swagger": "2.0",
    "info": {
        "description": "Create a short code from a long HTTP(S) URL. Click analytics, auth, and custom aliases are out of v1. The redirect route is not part of this document.",
        "title": "URL Shortener API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/shorten": {
            "post": {
                "description": "Mapping created, or an existing active mapping returned",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Shorten"
                ],
                "summary": "Create a short URL",
                "parameters": [
                    {
                        "description": "Create a short URL",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/web.ShortenRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Mapping created, or an existing active mapping returned",
                        "schema": {
                            "$ref": "#/definitions/web.ShortenResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body (URL, TTL, script payload, or self-loop)",
                        "schema": {
                            "$ref": "#/definitions/web.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database unavailable",
                        "schema": {
                            "$ref": "#/definitions/web.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "web.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Bad Request"
                },
                "message": {
                    "type": "string",
                    "example": "longUrl is not a valid URI"
                },
                "shortCode": {
                    "type": "string"
                },
                "status": {
                    "type": "integer",
                    "example": 400
                }
            }
        },
        "web.ShortenRequest": {
            "type": "object",
            "properties": {
                "longUrl": {
                    "type": "string",
                    "example": "https://example.com/api-design/api-design-url-shortening-service/"
                },
                "ttlInDays": {
                    "type": "integer",
                    "maximum": 3650,
                    "minimum": 1,
                    "example": 365
                }
            }
        },
        "web.ShortenResponse": {
            "type": "object",
            "properties": {
                "expiresAt": {
                    "type": "string",
                    "example": "2027-11-12T09:25:00Z"
                },
                "longUrl": {
                    "type": "string",
                    "example": "https://example.com/api-design/api-design-url-shortening-service/"
                },
                "shortCode": {
                    "type": "string",
                    "maxLength": 7,
                    "minLength": 5,
                    "example": "b9K2x1"
                },
                "shortUrl": {
                    "type": "string",
                    "example": "http://localhost:8080/short/b9K2x1"
                }
            }
        }
    }
}